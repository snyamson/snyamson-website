# ── Environment ────────────────────────────────────────────────────────
# "staging" makes the site read unpublished DRAFTS from Sanity, adds a
# staging badge, and blocks all search indexing. Anything else (or unset)
# behaves as production and reads published content only.
NEXT_PUBLIC_SITE_ENV=production

# Canonical origin for this deployment — drives metadataBase, canonical
# URLs, robots.txt and the sitemap. On Vercel it falls back to the
# generated deployment URL when unset.
#   production  https://snyamson.com
#   staging     https://staging.snyamson.com
NEXT_PUBLIC_SITE_URL=https://snyamson.com

# ── Sanity — find these at https://www.sanity.io/manage ────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only. Required ONLY on staging: drafts are not public, so reading
# them needs a token with Viewer rights. Never prefix with NEXT_PUBLIC_ —
# a token that can read unpublished content must not reach the browser.
# Leave empty on production.
SANITY_READ_TOKEN=

# Server-only. Needed by `npm run sanity:import` to write seed content into
# the dataset — the site itself never uses it. Create one with Editor rights
# at https://www.sanity.io/manage → your project → API → Tokens.
# Never prefix this with NEXT_PUBLIC_, or it ships to the browser.
SANITY_WRITE_TOKEN=

# Shared secret for the publish webhook (Sanity → Manage → API → Webhooks).
# Must match the "Secret" field on the webhook exactly. Any long random
# string works: `node -e "console.log(crypto.randomUUID())"`
# Only used in production — webhooks cannot reach localhost.
SANITY_REVALIDATE_SECRET=

# Contact form delivery (Resend). Until all three are set, /api/contact
# returns 503 with a "not connected yet" message instead of silently
# dropping submissions.
#   RESEND_API_KEY      https://resend.com/api-keys
#   CONTACT_FROM_EMAIL  must be on a domain verified in Resend
#   CONTACT_TO_EMAIL    where enquiries land
# CONTACT_FROM_EMAIL must be a MAILBOX on a verified domain, not the domain
# itself. A subdomain is its own domain to Resend: verifying
# "website.example.com" does not permit sending from "example.com".
# Both of these forms work:
#   hello@website.example.com
#   Snyamson <hello@website.example.com>
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Your Name <hello@website.example.com>
CONTACT_TO_EMAIL=you@example.com
